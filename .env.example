# Answer generation (Groq free tier). Force a provider with LLM_PROVIDER=groq|hf
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Hosted embeddings + reranking (Jina). If unset, local bge models are used instead.
JINA_API_KEY=
# Optional: stop calling Jina after this many tokens (0 = unlimited)
JINA_TOKEN_BUDGET=0

# Intent decision API (small talk vs. real question). Required for intent detection.
OPENROUTER_API_KEY=

# Protect the app with a shared password (browser login box, any username). Set on public deployments.
APP_PASSWORD=
MAX_UPLOAD_MB=10

# Optional: Hugging Face generation instead of Groq
HF_TOKEN=
HF_MODEL_ID=
HF_ENDPOINT_URL=

# Local models, used only when JINA_API_KEY is unset
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
