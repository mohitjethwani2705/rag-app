# Hugging Face generation model (set when you have it)
HF_TOKEN=
HF_MODEL_ID=
# Optional: dedicated Inference Endpoint URL (overrides HF_MODEL_ID routing)
HF_ENDPOINT_URL=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Groq (free tier). If GROQ_API_KEY is set it is used instead of Hugging Face.
# Force a provider with LLM_PROVIDER=groq|hf
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
